<?xml version="1.0" encoding="utf-8"?>
<!-- Sky and grass, the same two colours (and roughly the same horizon line) every
     terrain scene in the game uses — see terrain_prairie.png etc. and AppleII.kt.
     Replaces a flat black background specifically so the wagon's black outline and
     wheels have something to read against: black-on-black made most of the wagon
     disappear into the background in Wear's own circular icon treatment. The horizon
     sits at ~52% down the viewport to line up with where the wagon icon's own wheels
     touch the ground, not at the 1/3 mark the full terrain scenes use — this canvas is
     square and mostly cropped away by that circular treatment, so the wagon (not the
     landscape) is what has to be centred correctly. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#0DA1FF"
        android:pathData="M0,0 L108,0 L108,56.6 L0,56.6 Z" />
    <path
        android:fillColor="#38CB00"
        android:pathData="M0,56.6 L108,56.6 L108,108 L0,108 Z" />
</vector>
